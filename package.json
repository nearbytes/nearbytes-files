{
  "name": "nearbytes-files",
  "version": "0.1.0",
  "description": "Nearbytes file protocol — encrypted file storage on top of the event log, with reactive volume",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./service": {
      "import": "./dist/service.js",
      "types": "./dist/service.d.ts"
    }
  },
  "scripts": {
    "prepack": "tsc",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "refresh": "node scripts/refresh.mjs",
    "update": "node scripts/update.mjs",
    "dev": "node scripts/dev-bootstrap.mjs && tsc --watch --preserveWatchOutput",
    "dev:fast": "tsc --watch --preserveWatchOutput",
    "probe:sync-matrix": "yarn build && node scripts/sync-matrix-probe.mjs",
    "probe:offline-reopen": "yarn build && node scripts/offline-reopen-probe.mjs",
    "probe:false-cursor": "yarn build && node scripts/false-cursor-probe.mjs",
    "probe:late-join-delete": "yarn build && node scripts/late-join-delete-probe.mjs",
    "probe:remote-joins": "yarn build && node scripts/remote-joins-probe.mjs",
    "probe:event-propagation": "yarn build && node scripts/event-propagation-run.mjs",
    "probe:cold-restart-propagation": "yarn build && node scripts/cold-restart-propagation-probe.mjs",
    "probe:cold-restart": "yarn build && node scripts/cold-restart-propagation-run.mjs",
    "resync-wipe": "node scripts/resync-wipe.mjs",
    "resync-wipe:dry": "node scripts/resync-wipe.mjs --dry-run"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "nearbytes-chat": "https://github.com/nearbytes/nearbytes-chat.git#commit=6892ff741b7af37796b529d04cbb00fe2064f3d3",
    "nearbytes-crypto": "https://github.com/nearbytes/nearbytes-crypto.git#commit=1e4fdba874181eea145107d2693bee0d367853d8",
    "nearbytes-log": "https://github.com/nearbytes/nearbytes-log.git#commit=32a77dc63f63dbbda8fc74bc4b8cbca2459a3888",
    "nearbytes-skeleton": "https://github.com/nearbytes/nearbytes-skeleton.git#commit=55678adbb3f68babfca33e8d1f01b937493d5bce"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  },
  "packageManager": "yarn@4.15.0"
}
