{
  "name": "nearbytes-files",
  "version": "0.1.0",
  "description": "Nearbytes file protocol — encrypted file storage on top of the event log, with reactive volume and CLI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nbf": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "prepare": "tsc",
    "run": "node dist/cli/index.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "nearbytes-crypto": "file:../nearbytes-crypto",
    "nearbytes-log": "file:../nearbytes-log",
    "nearbytes-skeleton": "file:../nearbytes-skeleton"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  }
}
