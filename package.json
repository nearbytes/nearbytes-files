{
  "name": "nearbytes-files",
  "version": "0.1.0",
  "description": "Nearbytes file protocol — encrypted file storage on top of the event log, with reactive volume and CLI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nbf": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./service": {
      "import": "./dist/service.js",
      "types": "./dist/service.d.ts"
    },
    "./chat": {
      "import": "./dist/chat.js",
      "types": "./dist/chat.d.ts"
    },
    "./cli/context": {
      "import": "./dist/cli/context.js",
      "types": "./dist/cli/context.d.ts"
    },
    "./chatCodec": {
      "import": "./dist/chatCodec.js",
      "types": "./dist/chatCodec.d.ts"
    }
  },
  "scripts": {
    "prepack": "tsc",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "nbf": "tsc && node dist/cli/index.js",
    "repl": "tsc && node dist/cli/index.js repl",
    "update": "node scripts/update.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "nearbytes-crypto": "github:nearbytes/nearbytes-crypto#b63d261fb470e135b20a7c2f5f85691ffa52d695",
    "nearbytes-log": "github:nearbytes/nearbytes-log#10ff0f0cb8b57b0e6c7ad2e73c7e0d48205295e9",
    "nearbytes-skeleton": "github:nearbytes/nearbytes-skeleton#cd90ff2c988431a6dadcd5f3032dd9207b106e8b"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  },
  "packageManager": "yarn@4.15.0"
}
