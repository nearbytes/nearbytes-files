{
  "name": "nearbytes-files",
  "version": "0.1.0",
  "description": "Nearbytes file protocol — encrypted file storage on top of the event log, with reactive volume and CLI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nbf": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./service": {
      "import": "./dist/service.js",
      "types": "./dist/service.d.ts"
    },
    "./chat": {
      "import": "./dist/chat.js",
      "types": "./dist/chat.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "prepare": "tsc",
    "nbf": "node dist/cli/index.js",
    "repl": "node dist/cli/index.js repl",
    "test:sync-bidirectional": "node dist/scripts/sync-bidirectional-test.js",
    "test:sync-bidirectional:local": "node scripts/run-sync-bidirectional-local.mjs",
    "test:sync-bidirectional:remote": "bash scripts/run-sync-bidirectional-remote.sh"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "nearbytes-crypto": "file:../nearbytes-crypto",
    "nearbytes-log": "file:../nearbytes-log",
    "nearbytes-skeleton": "file:../nearbytes-skeleton"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  }
}
